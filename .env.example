# Public base URL of the deployed site (no trailing slash).
# Used by metadata (canonical, Open Graph), sitemap.xml and robots.txt.
# Set this in Vercel → Project → Settings → Environment Variables for Production.
# Example: https://sebastiancuesta.com
NEXT_PUBLIC_SITE_URL=https://sebastiancuesta.com

# PHASE 1: CONTACT FORM (off until all server secrets are configured)
# NEXT_PUBLIC_ variables are visible in the browser; never put secrets in them.
NEXT_PUBLIC_CONTACT_FORM_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret: Cloudflare Turnstile Siteverify key
TURNSTILE_SECRET_KEY=
# Secret: Resend API key for your verified sending domain
RESEND_API_KEY=
# Sender must be verified with Resend, e.g. Sebastian Website <hello@sebastiancuesta.com>
CONTACT_FROM_EMAIL=
# Private recipient list configured in Vercel, not publicly displayed or committed
CONTACT_TO_EMAILS=
CONTACT_ALLOWED_HOSTNAMES=sebastiancuesta.com,www.sebastiancuesta.com
